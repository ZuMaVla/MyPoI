<form class="box" action="/category/{{place.categoryId}}/place/{{place._id}}/addreview" method="POST">
  <label class="label">Your review:</label>
  <div class="field is-horizontal">
    <div class="field-body">
      <div class="field">
        <textarea class="textarea" name="review" placeholder="Enter your review here" rows="4" cols="50"></textarea>
      </div>
      <div>
        <button class="button is-primary" type="submit">Add Review</button>
      </div>
    </div>
  </div>
</form>