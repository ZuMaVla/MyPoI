{{#each categoriesToView}}
  <div class="box box-link-hover-shadow is-flex is-align-items-center">
    <h2 class="title mb-0 mr-auto">
      {{ categoryName }}
    </h2>
    <a id="open-list" class="button is-align-items-center" href="/category/{{_id}}">
      <span class="icon is-small">
        {{> open-image}}
      </span>
    </a>
    <a id="delete-list" class="button is-align-items-center" href="/delete_category/{{_id}}">
      <span class="icon is-small">
        {{> delete-image}}
      </span>
    </a>
  </div>
{{/each}}