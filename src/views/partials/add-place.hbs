<form class="box" action="/category/{{categoryId}}/addplace" method="POST">
  <label>Enter New Place Details:</label>
  <div class="field is-horizontal">
    <div class="field-body">
      <div class="field">
        <input class="input" type="text" placeholder="Enter Place Name" name="name" />
      </div>
      <div class="field">
        <input class="input" type="text" placeholder="Enter Description" name="description" />
      </div>
      <div class="field">
        <input class="input" type="text" placeholder="Enter latitude (51.3:55.5)" name="latitude" />
      </div>
      <div class="field">
        <input class="input" type="text" placeholder="Enter longitude (-10.7:-5.3)" name="longitude" />
      </div>
      <div class="field">
        <div class="control">
          <div class="select">
            <select name="_private">
              <option value="false">Public</option>
              <option value="true">Private</option>
            </select>
          </div>
        </div>
      </div>
    </div>
  </div>
  <button class="button is-primary">Add Place</button>
</form>