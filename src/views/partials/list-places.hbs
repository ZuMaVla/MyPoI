<table class="table is-fullwidth mb-0">
  <thead>
    <tr>
      <th style="width: 25%;">Place</th>
      <th style="width: 30%;">Description</th>
      <th style="width: 10%;">Rating</th>
      <th style="width: 22%;">My rating</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <b>My private places:</b>
    {{#each privatePlaces}}
      <tr>
        <td>
          {{this.name}}
        </td>
        <td>
          {{this.description}}
        </td>
        <td>
          {{this.averageRating}}
        </td>
        <td>
          {{> vote}}
        </td>
        <td class="has-text-right">
          <a id="private-place" class="button" href="/category/{{categoryId}}/place/{{_id}}/toggleprivacy">
            <span class="icon is-small">
              {{#if (eq this._private true)}}
                {{> locked-image}}
              {{else}}
                {{> unlocked-image}}
              {{/if}}
            </span>
          </a>
          <a id="open-place" class="button" href="/category/{{categoryId}}/place/{{_id}}">
            <span class="icon is-small">
              {{> open-image}}
            </span>
          </a>
          <a id="delete-place" class="button" href="/category/{{categoryId}}/delete_place/{{_id}}">
            <span class="icon is-small">
              {{> delete-image}}
            </span>
          </a>
        </td>
      </tr>
    {{/each}} 
    </tbody>
  </table>
<table class="table is-fullwidth mb-0">
  <thead>
    <tr>
      <th style="width: 25%;"></th>
      <th style="width: 30%;"></th>
      <th style="width: 10%;"></th>
      <th style="width: 22%;"></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <b>My favourite places:</b>  
    {{#each favouritePlaces}}
      <tr class="mb-0">
        <td>
          {{this.name}}
        </td>
        <td>
          {{this.description}}
        </td>
        <td>
          {{this.averageRating}}
        </td>
        <td>
          {{> vote}}
        </td>
        <td class="has-text-right">
          <button id="share-favourite-place" class="button" onclick="navigator.share({
            title: 'Check out this place!',
            text: 'I found this cool place!',
            url: `{{url}}/category/{{categoryId}}/place/{{_id}}`
          })">
            <span>{{> share-image}}</span>
            
          </button>
          <a id="remove-place-from-favourite" class="button has-heart-hover" href="/category/{{categoryId}}/place/{{_id}}/removefavourite">
            <span class="heart-wrapper">
              <span class="icon is-small heart-default">
                {{> favourite-image}}
              </span>
              <span class="icon is-small heart-hover">
                {{> unfavourite-image}}
              </span>
            </span>
          </a>
          <a id="open-place" class="button" href="/category/{{categoryId}}/place/{{_id}}">
            <span class="icon is-small">
              {{> open-image}}
            </span>
          </a>
          <a id="delete-place" class="button is-hidden" href="/category/{{categoryId}}/delete_place/{{_id}}">
            <span class="icon is-small">
              {{> delete-image}}
            </span>
          </a>
        </td>
      </tr>
    {{/each}}
  </tbody>
</table>

